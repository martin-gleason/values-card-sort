# macOS
.DS_Store

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Xcode — the project is GENERATED from project.yml by scripts/bootstrap.sh.
# Never commit it; edit project.yml instead.
*.xcodeproj/
*.xcworkspace/
DerivedData/
xcuserdata/
*.xcuserstate

# Xcode build by-products
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
timeline.xctimeline

# Python
__pycache__/
*.pyc

# Node — CI-only tooling for the web port's accessibility and rule gates
# (axe-core, puppeteer-core). Nothing here is shipped to the browser: web/
# loads no modules and references no CDN. package-lock.json IS committed, so
# CI installs the exact versions the gate was proved against.
node_modules/

# Fixtures are instrument source PDFs downloaded by the maintainer (chore C1).
# They are public-domain documents, not repo artifacts.
fixtures/*.pdf

# Generated by XcodeGen from project.yml — edit that instead.
App/Info.plist
App/ValuesCardSort.entitlements

# Local-only working docs. These carry the maintainer's personal context and
# are deliberately kept out of the public history.
CLAUDE.local.md
docs/decisions.md
